{
  "name": "interviewbar-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 10/11 秋招面试日程与投递面板",
  "main": "dist-electron/electron/main.js",
  "author": "InterviewBar Windows contributors",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node scripts/visual-check.cjs",
    "test:electron": "node scripts/electron-smoke.cjs",
    "test:packaged": "cross-env INTERVIEWBAR_EXECUTABLE=release/win-unpacked/秋招面板.exe node scripts/electron-smoke.cjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run test && npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --win nsis portable",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.44.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "cn.interviewbar.windows",
    "productName": "秋招面板",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "InterviewBar-Windows-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "秋招面板"
    },
    "portable": {
      "artifactName": "InterviewBar-Windows-${version}-${arch}-Portable.${ext}"
    }
  }
}
